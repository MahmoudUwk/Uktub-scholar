{
  "name": "uktub-scholar",
  "version": "0.2.0",
  "description": "Local-first scholarly research tools for coding agents: paper search, registry, bibliography, LaTeX compilation, RAG passage search, and claim verification. Unified Stdio MCP server, Pi package, and CLI.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "keywords": [
    "pi-package",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "scholarly",
    "latex"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "uktub-scholar": "./bin/uktub-scholar.js"
  },
  "pi": {
    "extensions": [
      "./src/pi"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.spec.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22.20.5",
    "typebox": "^1.3.34"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "tar": "^7.5.22",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1"
  }
}
