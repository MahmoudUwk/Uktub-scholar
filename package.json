{
  "name": "uktub-scholar",
  "version": "0.2.0",
  "description": "Local-first scholarly research tools for coding agents: paper search, registry, bibliography, LaTeX compilation, RAG passage search, and claim verification. Unified Stdio MCP server, Pi package, and CLI.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "keywords": [
    "pi-package",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "scholarly",
    "latex"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "uktub-scholar": "./bin/uktub-scholar.js"
  },
  "pi": {
    "extensions": [
      "./dist/pi"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs src dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"tests/*.spec.ts\"",
    "live:probe": "node scripts/live/boundary-probe.ts experiments/runs/acceptance/probe-$(date +%Y%m%dT%H%M%S)",
    "live:direct": "node scripts/live/run.ts --suite direct",
    "live:agent": "node scripts/live/run.ts --suite agent",
    "experiment": "node scripts/live/experiment.ts",
    "evolve": "node scripts/live/evolve.ts",
    "sandbox": "node scripts/live/shell.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.20.5",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "tar": "^7.5.22",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "scripts/*.py",
    "scripts/*.json",
    "scripts/build-assets.mjs",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
