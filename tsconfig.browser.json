{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "baseUrl": ".",
