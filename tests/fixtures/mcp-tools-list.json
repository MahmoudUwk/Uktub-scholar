  {
    "name": "compile",
    "title": "Compile document",
    "description": "Compile the project's LaTeX entry with a local Tectonic engine (the user's binary: PATH or UKTUB_TECTONIC_BIN). Entry defaults to manuscript/main.tex, then main.tex, then a lone top-level .tex; with several candidates the refusal names them. Output (PDF) lands in build/; structured diagnostics (severity, file, line, message) come back on failure, so fix and recompile. The engine must be installed — a missing engine is a refusal, not a download. On failure the result is an error carrying a stable code — e.g. `Refused: CODE — what happened. Next: what to do.`",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Project-relative .tex path; omit to use the default entry resolution"
        }
      }
    },
    "outputSchema": {
