[
  {
    "name": "papers",
    "title": "Search papers",
    "description": "Search OpenAlex, Crossref, and Semantic Scholar for papers matching a query. Returns merged candidates in a deterministic relevance order with per-provider warnings; a single provider failing degrades the result, and a DOI-shaped query still searches. At most 20 results per call (client policy after a tool-payload incident). On failure the result is an error carrying a stable code — e.g. `Refused: CODE — what happened. Next: what to do.`",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Free-text scholarly query; DOI-shaped strings are allowed and hinted"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Max candidates to return (default 5, cap 20)"
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "doi",
              "authors",
              "venue",
              "year",
              "citationCount",
              "endpoint"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "doi": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "venue": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "year": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "citationCount": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endpoint": {
                "type": "string"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "code",
              "message"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "requested": {
          "type": "number"
        },
        "returned": {
          "type": "number"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "query",
        "candidates",
        "warnings",
        "requested",
        "returned",
        "truncated"
      ]
    },
    "annotations": {
      "title": "Search papers",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "registry",
    "title": "Paper registry",
    "description": "Manage the project's paper collection in one tool. action=register: add papers by DOI or arxiv:YYMM.NNNNN (at most 50); every input gets an outcome in order, aliases of one paper register once, a refresh keeps the pinned citekey. action=remove: delete explicit DOIs/citekeys (at most 50; there is no remove-all). action=read: list all papers or an explicit subset with the fields you ask for (default title, year, citable; also authors, venue, bibtex, bibtexSource, abstract, source, refreshedAt), paged with a cursor. action=attach_source: prepare a PDF or GROBID TEI file inside the project as a paper's source (at most 10); the file is neither copied nor deleted and its text is never shown to you. action=sync_bibliography: re-render refs/references.bib from the registry. action=acquire: fetch an open-access source for papers that have none (omit handles for all of them; the same work registration starts in the background); read with the source field shows each paper's source status: metadata_only, acquiring, ready, unavailable or failed. A paper without provider BibTeX is citable: false — BibTeX is never synthesized. Sources: register a paper only when the user asks or the text you write cites it, and only DOIs from search results or the user; if the user says to use only the papers already registered, neither search nor register more. A paper the user names that is not found is reported as not found: never substitute another work. refs/references.bib is rendered from the registry: never edit it by hand (use sync_bibliography). Only if the user asks for a stub citation, write it in a separate .bib file with only the fields the user gave and note={UNREGISTERED PLACEHOLDER - verify}, and say it is a placeholder. On failure the result is an error carrying a stable code — e.g. `Refused: CODE — what happened. Next: what to do.`",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "register"
            },
            {
              "type": "string",
              "const": "remove"
            },
            {
              "type": "string",
              "const": "read"
            },
            {
              "type": "string",
              "const": "attach_source"
            },
            {
              "type": "string",
              "const": "sync_bibliography"
            },
            {
              "type": "string",
              "const": "acquire"
            }
          ],
          "description": "register | remove | read | attach_source | sync_bibliography | acquire"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "description": "register: DOIs (10.xxxx/suffix, doi: or doi.org forms) or arxiv:YYMM.NNNNN; at most 50"
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "description": "remove: DOIs or citekeys to delete (required, never \"all\"); read: restrict to these papers (omit for every paper); acquire: papers to fetch an open-access source for (omit for every paper without a source); at most 50"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "read: fields to return besides doi and citekey; default title, year, citable. Allowed: title, year, citable, authors, venue, bibtex, bibtexSource, abstract, source, refreshedAt"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "read: page size (default 50; at most 100, or 25 with abstract/bibtex)"
        },
        "cursor": {
          "type": "string",
          "description": "read: continuation token from the previous page of the same request"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "handle",
              "path"
            ],
            "properties": {
              "handle": {
                "type": "string",
                "description": "DOI or citekey of a registered paper"
              },
              "path": {
                "type": "string",
                "description": "PDF or GROBID TEI file inside the project"
              }
            }
          },
          "maxItems": 10,
          "description": "attach_source: local files to prepare as these papers' sources; at most 10"
        }
      },
      "required": [
        "action"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
