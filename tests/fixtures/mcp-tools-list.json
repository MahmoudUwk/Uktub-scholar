                },
                "unavailable": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  }
                },
                "unresolved": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  }
                },
                "preprint": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "candidates": {
              "type": "object",
              "required": [
                "total",
                "perPaper"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "perPaper": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  }
                }
              }
            },
            "work": {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            },
            "output": {
              "type": "object",
              "required": [
                "available",
                "returned",
                "deliveredEarlier",
                "withheld",
                "staleDropped"
              ],
              "properties": {
                "available": {
                  "type": "integer"
                },
                "returned": {
                  "type": "integer"
                },
                "deliveredEarlier": {
                  "type": "integer"
                },
                "withheld": {
                  "type": "integer"
                },
                "staleDropped": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "direct": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
