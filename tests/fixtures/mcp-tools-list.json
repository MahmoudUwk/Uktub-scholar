  {
    "name": "verify",
    "title": "Verify claim",
    "description": "Find support for ONE claim in the registered papers: papers is \"all\" or an explicit list of DOIs/citekeys. The package prepares sources, searches and judges internally; you receive only supporting passages with exact pointers (doi@revision#start-end) and four separate coverage reports — sources, candidates, work, output. \"No support found\" is not evidence that the claim is false. If verify cannot run, the claim stays unverified: passages you retrieved are unchecked reading, never support. An optional query only narrows WHICH passages are checked (the search is then query-limited, not exhaustive). If the response carries a continuation, repeat the same request with it to continue unfinished checking or page more evidence. Rare direct path: passages=[{source: pointer}|{text}] judges exactly those passages; text carries no paper provenance. Engine and bar come from verification.* in config/chunking.yaml or the documented defaults. Document mode (exclusive with the above): {document: project-relative .tex path} or {text: LaTeX fragment} checks the text as written, one unit at a time (cited units against their own papers, uncited units against all papers), with per-unit supported | cited-unsupported | missing-citation | unsourced | unregistered | skipped (too short, or too long — split it). At most 50 units per call (client policy); exhaustive per unit at the configured bar, so it is slow with local Eos. On failure the result is an error carrying a stable code — e.g. `Refused: CODE — what happened. Next: what to do.`",
    "inputSchema": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2000,
          "description": "ONE proposition to find support for, stated as a sentence; it is passed to the verifier unchanged"
        },
        "papers": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 100
            }
          ],
          "description": "Scope: \"all\" registered papers, or an explicit list of DOIs/citekeys (at most 100); an empty list is refused, never read as all"
        },
        "query": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional locator words that only narrow WHICH passages are checked; the claim is unchanged and the search becomes query-limited, not exhaustive. The hosted engine otherwise checks the top-10 retrieval candidates per claim (every passage on other engines, or with UKTUB_VERIFY_STRATEGY=exhaustive) and can take minutes for long papers; use a query when a focused check is enough"
        },
        "passages": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "pointer from an earlier result (doi@revision#start-end)"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 4000,
                    "description": "caller-supplied text; judged with no paper attribution"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "description": "Rare direct path instead of papers: judge exactly these passages (at most 8)"
        },
        "continuation": {
          "type": "string",
          "description": "Token from the previous response of the SAME request: continues unfinished checking and/or the next page of evidence"
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "description": "Document mode (exclusive with claim, papers, query, passages, continuation): project-relative .tex entry to check as written, its includes expanded"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Document mode (exclusive with claim, papers, query, passages, continuation): LaTeX fragment to check as written"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Document mode: first unit to check (pages of 50 units); the result names the next offset until the whole text is checked"
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "required": [
            "supportFound",
            "searched",
            "complete",
            "limitations"
          ],
          "properties": {
            "supportFound": {
              "type": "boolean"
            },
            "searched": {
              "type": "string"
            },
            "complete": {
              "type": "boolean"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "engine": {
          "type": "object",
          "required": [
            "name",
            "model",
            "protocol",
            "minConfidence",
            "cache"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol": {
              "type": "string"
            },
            "minConfidence": {
              "type": "number"
            },
            "cache": {
              "type": "boolean"
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "sources",
            "candidates",
            "work",
            "output"
          ],
          "properties": {
            "sources": {
              "type": "object",
              "required": [
                "selected",
                "ready",
                "unavailable",
                "unresolved",
                "preprint"
              ],
              "properties": {
                "selected": {
                  "type": "integer"
                },
                "ready": {
